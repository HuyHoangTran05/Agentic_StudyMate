# Agentic StudyMate backend environment example.
# Copy to backend/.env and replace placeholder values.
# Do not commit real API keys or passwords.

DATABASE_URL=sqlite+aiosqlite:///./studymate.db

GROQ_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

TEXT_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=studymate_chunks

NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_password

EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
UPLOAD_DIR=uploads
